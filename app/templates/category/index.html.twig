{% extends 'base.html.twig' %}

{% block title %}Liste des Catégories{% endblock %}

{% block body %}
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-2xl font-bold">Liste des Catégories</h1>
        <a href="{{ path('app_category_new') }}" class="btn btn-primary">+ Ajouter une Catégorie</a>
    </div>

    <div class="overflow-x-auto bg-base-100 rounded-box shadow">
        <table class="table table-zebra">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Couleur</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for category in categories %}
                    <tr>
                        <td class="font-medium">{{ category.name }}</td>
                        <td>
                            <span class="inline-block w-5 h-5 rounded border align-middle" style="background: {{ category.color }}"></span>
                            <span class="ml-2">{{ category.color }}</span>
                        </td>
                        <td class="text-right space-x-2">
                            <a href="{{ path('app_category_edit', {id: category.id}) }}" class="btn btn-sm btn-secondary">Modifier</a>
                            <form method="post" action="{{ path('app_category_delete', {id: category.id}) }}" class="inline" onsubmit="return confirm('Supprimer cette catégorie ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                <button class="btn btn-sm btn-error" type="submit">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center py-8 opacity-60">Aucune catégorie pour le moment.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
