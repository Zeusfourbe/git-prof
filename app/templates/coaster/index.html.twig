{% extends 'base.html.twig' %}

{% block title %}Liste des Coasters{% endblock %}

{% block body %}
    <div class="flex justify-between items-center mb-4">
        <h1 class="text-2xl font-bold">Liste des Coasters</h1>
        <a href="{{ path('coaster_new') }}" class="btn btn-primary">+ Ajouter un Coaster</a>
    </div>

    <form method="get" action="{{ path('coaster_index') }}" class="flex flex-wrap items-end gap-4 mb-4">
        <label class="flex flex-col gap-1">
            <span class="text-sm">Parc</span>
            <select name="park" class="select select-bordered">
                <option value="">Tous les parcs</option>
                {% for park in parks %}
                    <option value="{{ park.id }}" {{ (park.id ~ '') == selectedPark ? 'selected' : '' }}>{{ park.name }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="flex flex-col gap-1">
            <span class="text-sm">Catégorie</span>
            <select name="category" class="select select-bordered">
                <option value="">Toutes les catégories</option>
                {% for category in categories %}
                    <option value="{{ category.id }}" {{ (category.id ~ '') == selectedCategory ? 'selected' : '' }}>{{ category.name }}</option>
                {% endfor %}
            </select>
        </label>
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel-fill"></i> Filtrer</button>
        <a href="{{ path('coaster_index') }}" class="btn btn-ghost">Réinitialiser</a>
    </form>

    <div class="overflow-x-auto bg-base-100 rounded-box shadow">
        <table class="table table-zebra">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Parc</th>
                    <th>Catégories</th>
                    <th>Vitesse max</th>
                    <th>Longueur</th>
                    <th>Hauteur max</th>
                    <th>En service</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for coaster in coasters %}
                    <tr>
                        <td class="font-medium">{{ coaster.name }}</td>
                        <td>{{ coaster.park ?? '—' }}</td>
                        <td>
                            {% for category in coaster.categories %}
                                <span class="badge text-white mr-1" style="background: {{ category.color }}">{{ category.name }}</span>
                            {% else %}
                                —
                            {% endfor %}
                        </td>
                        <td>{{ coaster.maxSpeed ?? '—' }}</td>
                        <td>{{ coaster.length ?? '—' }}</td>
                        <td>{{ coaster.maxHeight ?? '—' }}</td>
                        <td>
                            {% if coaster.operating %}
                                <span class="badge badge-success">Oui</span>
                            {% else %}
                                <span class="badge badge-ghost">Non</span>
                            {% endif %}
                        </td>
                        <td class="text-right space-x-2">
                            <a href="{{ path('coaster_edit', {id: coaster.id}) }}" class="btn btn-sm btn-secondary">Modifier</a>
                            <form method="post" action="{{ path('coaster_delete', {id: coaster.id}) }}" class="inline" onsubmit="return confirm('Supprimer ce Coaster ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ coaster.id) }}">
                                <button class="btn btn-sm btn-error" type="submit">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-8 opacity-60">Aucun coaster pour le moment.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% include 'utils/_pagination.html.twig' with {'route': 'coaster_index', 'pageCount': (coasters.count / 20)|round(0, 'ceil')} %}
{% endblock %}
